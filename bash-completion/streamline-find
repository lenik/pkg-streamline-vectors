# bash completion for streamline-find

_streamline_find()
{
    local cur prev words cword
    _init_completion || return

    case "$prev" in
        -h|--help|--version)
            return
            ;;
        -q|--quiet|-v|--verbose)
            # No completion for these options
            return
            ;;
    esac

    # Check if we're completing an option
    case "$cur" in
        -*)
            COMPREPLY=( $(compgen -W "-h --help --version -q --quiet -v --verbose" -- "$cur") )
            return
            ;;
    esac

    # Complete with common search terms from the icon collection
    local categories="plump core flex sharp ultimate block covid cyber guidance kameleon logos memes nasty-icons pixel stickies freebies-freemojis freehand"
    local styles="duo flat gradient line neon pop solid remix bold colors regular"
    local subcategories="arrows commerce interface-essential leisure technology wellness activity animals-nature building-real-estate business coding-apps-websites colors content-files ecology education-entertainment finance food-drink health-beauty lifestyle maps-navigation medical music photography religion spirituality sports transportation travel weather work"

    COMPREPLY=( $(compgen -W "$categories $styles $subcategories" -- "$cur") )
}

complete -F _streamline_find streamline-find
