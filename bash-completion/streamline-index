# bash completion for streamline-index

_streamline_index()
{
    local cur prev words cword
    _init_completion || return

    case "$prev" in
        -h|--help|--version)
            return
            ;;
        -o|--output)
            _filedir
            return
            ;;
        -c|--content|-f|--force|-q|--quiet|-r|--recursive|-v|--verbose)
            # No completion for these options
            return
            ;;
    esac

    # Check if we're completing an option
    case "$cur" in
        -*)
            COMPREPLY=( $(compgen -W "-h --help --version -c --content -r --recursive -f --force -o --output -q --quiet -v --verbose" -- "$cur") )
            return
            ;;
    esac

    # Complete directory and file paths for FILES/DIR arguments
    _filedir
}

complete -F _streamline_index streamline-index
